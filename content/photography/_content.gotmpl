{{/*
  Content adapter: one page per trip in data/photography.json.
  The JSON is generated by photography/build.py; do not edit trip pages here.
*/}}
{{ with site.Data.photography }}
  {{ range .trips }}
    {{ $dates := dict }}
    {{ with .start }}{{ $dates = dict "date" (time.AsTime .) }}{{ end }}
    {{ $page := dict
      "path" .slug
      "title" .title
      "kind" "page"
      "dates" $dates
      "content" (dict "mediaType" "text/markdown" "value" .description)
      "params" (dict "trip" .slug "description" (.description | plainify | truncate 160))
    }}
    {{ $.AddPage $page }}
  {{ end }}
{{ end }}
